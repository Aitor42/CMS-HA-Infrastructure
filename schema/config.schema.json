    "BackupConfig": {
      "additionalProperties": false,
      "properties": {
        "access_key": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "data_dir": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "garage_version": {
          "type": "string"
        },
        "restore_test_schedule": {
          "type": "string"
        },
        "retention_days": {
          "type": "integer"
        },
        "s3_port": {
          "type": "integer"
        },
        "s3_region": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "secret_key": {
          "type": "string"
        }
      },
      "title": "BackupConfig",
      "type": "object"
    },
    "Config": {
      "additionalProperties": false,
      "properties": {
        "backup": {
          "$ref": "#/$defs/BackupConfig"
        },
        "database": {
          "$ref": "#/$defs/DatabaseConfig"
        },
        "deploy": {
          "$ref": "#/$defs/DeployConfig"
        },
        "drbd": {
          "$ref": "#/$defs/DRBDConfig"
        },
        "monitoring": {
          "$ref": "#/$defs/MonitoringConfig"
        },
        "network": {
          "$ref": "#/$defs/NetworkConfig"
        },
        "nodes": {
          "$ref": "#/$defs/NodesConfig"
        },
        "pki": {
          "$ref": "#/$defs/PKIConfig"
        },
        "ssh": {
          "$ref": "#/$defs/SSHConfig"
        },
        "traffic": {
          "$ref": "#/$defs/TrafficConfig"
        },
        "vm": {
          "$ref": "#/$defs/VMConfig"
        },
        "wordpress": {
          "$ref": "#/$defs/WordPressConfig"
        }
      },
      "title": "Config",
      "type": "object"
