          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "root_password": {
          "type": "string"
        },
        "user": {
          "type": "string"
        }
      },
      "title": "DatabaseConfig",
      "type": "object"
    },
    "DeployConfig": {
      "additionalProperties": false,
      "properties": {
        "install_batch_size": {
          "type": "integer"
        },
        "node_install_timeout": {
          "description": "Go duration, for example 10s, 15m or 2h; an integer is interpreted as nanoseconds.",
          "type": [
            "string",
            "integer"
          ]
        },
        "puppet_concurrency": {
          "type": "integer"
        },
        "ssh_timeout": {
          "description": "Go duration, for example 10s, 15m or 2h; an integer is interpreted as nanoseconds.",
          "type": [
            "string",
            "integer"
          ]
        },
        "stagger_delay": {
          "description": "Go duration, for example 10s, 15m or 2h; an integer is interpreted as nanoseconds.",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "DeployConfig",
      "type": "object"
