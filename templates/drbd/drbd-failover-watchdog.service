[Unit]
Description=DRBD Automatic Failover Watchdog Daemon
# The boot-time role resolver must finish before the watchdog may mount and
# label a node: a stale Primary coming back from a power cut has to be demoted
# before the watchdog can mistake it for the active writer.
After=network-online.target drbd.service drbd-cms-boot.service
Wants=network-online.target drbd.service drbd-cms-boot.service
Before=k3s.service

[Service]
Type=simple
ExecStart=/usr/local/bin/drbd-watchdog.sh
Restart=always
RestartSec=3
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
