# NAT Rules for the Router
#   - DNAT: Redirects external HTTP/HTTPS traffic to the load balancer VIP
#     (${LB_VIP}), which keepalived floats between main-lb1 and main-lb2
#   - MASQUERADE: Outbound NAT to allow internet access from the Internal and
#     Main networks
#
*nat
:PREROUTING ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

# DNAT: Internet -> LB VIP (keepalived floating address, main-lb1/main-lb2)
-A PREROUTING -i ${WAN_IF} -p tcp --dport 80 -j DNAT --to-destination ${LB_VIP}:80
-A PREROUTING -i ${WAN_IF} -p tcp --dport 443 -j DNAT --to-destination ${LB_VIP}:443

# MASQUERADE: Outbound NAT for Internal and Main networks
-A POSTROUTING -s ${INTERNAL_CIDR} -o ${WAN_IF} -j MASQUERADE
-A POSTROUTING -s ${MAIN_CIDR} -o ${WAN_IF} -j MASQUERADE

COMMIT
